# Copy to .env and export these in your shell; the backend does not load .env files itself.

# Optional Gemini chat. Chat is disabled unless the key is set AND the free-tier flag is exactly "true".
GEMINI_API_KEY=
GEMINI_FREE_TIER_CONFIRMED=
# Must be on the allowlist in app/services/crypto_chat.py
GEMINI_MODEL=gemini-3.8-flash
# Attempted chat calls per process per UTC day (0 disables chat)
CHAT_DAILY_REQUEST_LIMIT=20

# Optional CoinGecko keys (pro wins if both are set)
COINGECKO_DEMO_API_KEY=
COINGECKO_PRO_API_KEY=

# Comma-separated CORS origins
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
